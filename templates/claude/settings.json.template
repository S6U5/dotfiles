{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(npm exec:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(uv sync:*)",
      "Bash(uv tool install:*)",
      "Bash(uvx:*)",
      "Bash(brew install:*)",
      "Bash(apt-get install:*)",
      "Bash(apt install:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(> /dev/sda)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git reset --hard *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/shell/local.sh)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/glab-cli/config.yml)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc)",
      "Read(~/.yarnrc.yml)",
      "Read(~/.bunfig.toml)",
      "Read(~/.pypirc)",
      "Read(~/.config/pip/pip.conf)",
      "Read(~/.pip/pip.conf)",
      "Read(~/.local/share/uv/credentials/**)",
      "Read(~/.config/pypoetry/auth.toml)",
      "Read(~/Library/Application Support/pypoetry/auth.toml)",
      "Read(~/.condarc)",
      "Read(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.gem/credentials)",
      "Read(~/.composer/auth.json)",
      "Read(~/.config/composer/auth.json)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.m2/settings-security.xml)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.config/dart/pub-tokens.json)",
      "Read(~/.config/nix/nix.conf)",
      "Read(~/.config/nix/netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/config)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.gemini/oauth_creds.json)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/notify\" 'Claude Code' 'Claude Code needs your attention'"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "spinnerTipsEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "agentPushNotifEnabled": true
}
