{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "permissions": {
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(npm exec:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(brew install:*)",
      "Bash(apt-get install:*)",
      "Bash(apt install:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(> /dev/sda)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git reset --hard *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/notify\" 'Claude Code' 'Claude Code needs your attention'"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "spinnerTipsEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "agentPushNotifEnabled": true
}
