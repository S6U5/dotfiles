#!/bin/sh
# home-manager switch を実行して dotfiles を反映する(switch.sh をどこからでも呼べるようにするラッパー)。
# インストール後の実体はリポジトリへのシンボリックリンクなので、
# 自身のリンクをたどってリポジトリの場所を割り出す(パスのハードコードを避ける)。
# 引数はそのまま switch.sh(→ home-manager switch)に渡す(例: dotfiles-switch -b bak)。
set -eu

target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case "$link" in
    /*) target=$link ;;
    *) target=$(dirname "$target")/$link ;;
  esac
done

repo=$(cd "$(dirname "$target")/../../.." && pwd)

if [ ! -x "$repo/switch.sh" ]; then
  echo "dotfiles-switch: リポジトリが見つかりません($repo に switch.sh がありません)" >&2
  exit 1
fi

exec "$repo/switch.sh" "$@"
