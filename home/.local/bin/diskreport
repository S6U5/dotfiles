  report_nix
  if [ -n "$hints" ]; then
    echo "容量が気になるときは diskreport(何も消さない)で確認し、必要なら:$hints"
  fi
  exit 0
fi

if [ "$WINDOWS" -eq 1 ]; then
  report_windows_open
  exit 0
fi
if [ "$SCAN" -eq 1 ]; then
  scan_home
  scan_windows
fi
offer_scan
report_disk
collect_ledgers
collect_paths
collect_projects
report_accounting
report_breakdown
report_index_home
report_apps_home
report_projects
report_bigfiles
report_nix
report_windows_ledger
report_index_windows
report_apps_windows
if [ "${RESIDUAL_SPIKE:-0}" -eq 1 ]; then
  add_hint "diskreport scan                             # 残差が増えた場所を索引で探す(1回だけ全部数える)"
fi
tui_hint
save_history "$WORK/save"

echo "== 次の一手(このコマンドは何も消しません)"
echo "  cachesweep                                  # 開発キャッシュのサイズ。--clean で削除"
printf '%s\n' "$hints" | sed '/^$/d'
if [ ! -f "$INDEX_HOME" ]; then
  echo "  diskreport scan                             # 索引を作る(1回だけ時間をかけて数え、以後の詳細・アプリ別は一瞬)"
elif [ "$SCAN" -eq 0 ]; then
  echo "  diskreport scan                             # 索引を作り直す(いまの索引は $(index_age_label "$INDEX_HOME"))"
fi
if is_wsl; then
  echo "  diskreport windows                          # Windows の「ストレージ」設定を開く(Windows 側の中身は Windows の道具で)"
fi
echo "  自分の環境の場所を一覧に足すには: ${CONF_DIR}/diskreport.local(形式は diskreport.paths と同じ)"
