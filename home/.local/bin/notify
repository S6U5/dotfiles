#!/bin/sh
# デスクトップ通知を出す(OS ごとの通知手段を吸収する)。
#   macOS: 通知センター / WSL: Windows のポップアップ / Linux: notify-send
# どの手段も無ければ標準出力に表示する(壊れない)。
# 使い方: notify <タイトル> [本文]
set -eu

title=${1:-通知}
body=${2:-}

case "$(uname -s)" in
  Darwin)
    if command -v osascript >/dev/null 2>&1; then
      osascript -e "display notification \"$body\" with title \"$title\"" 2>/dev/null && exit 0
    fi
    ;;
  Linux)
    if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
      if command -v powershell.exe >/dev/null 2>&1; then
        # 5 秒で自動で閉じるポップアップ
        (
          cd /mnt/c 2>/dev/null || cd /
          powershell.exe -NoProfile -Command \
            "(New-Object -ComObject WScript.Shell).Popup('$body', 5, '$title') | Out-Null" 2>/dev/null
        ) && exit 0
      fi
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send "$title" "$body" 2>/dev/null && exit 0
    fi
    ;;
esac

# フォールバック: 通知手段が無ければ端末に表示
printf '[notify] %s: %s\n' "$title" "$body"
