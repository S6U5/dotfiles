#!/bin/sh
# 自作コマンドとシェル関数の一覧を、用途ごとに分けて表示する。
#   dotfiles-help            # 一覧(home/.local/bin/ のコマンドと、home/.config/shell/ のシェル関数)
#   dotfiles-help <名前>     # コマンドならヘッダコメント全文(= <名前> --help と同じ内容)、
#                            # シェル関数なら定義の直上のコメント
# 説明文をここに二重に持たない。各スクリプトは2行目から始まるコメントの1文目(括弧の中の「。」では
# 切らない)を説明として読まれる前提で書く(シェル関数は定義の直上にあるコメントブロックの1行目)。
# ここで持つのは用途の分け方だけで、分けていないコマンドは「その他」に出る。
# 端末に出すときは色を付け、幅に収まらない説明は … で切る(NO_COLOR を設定すると色を付けない。
# パイプに流すときは色も切り詰めも無し)。WSL 専用のコマンドは、WSL 以外では名前だけを並べる。
set -eu

# インストール後の実体はリポジトリへのシンボリックリンクなので、自身のリンクをたどって
# リポジトリの場所を割り出す(パスのハードコードを避ける。dotfiles-update と同じ)
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case "$link" in
    /*) target=$link ;;
    *) target=$(dirname "$target")/$link ;;
  esac
done
repo=$(cd "$(dirname "$target")/../../.." && pwd)
bin_dir=$repo/home/.local/bin
shell_dir=$repo/home/.config/shell

if [ ! -d "$bin_dir" ]; then
  echo "dotfiles-help: リポジトリが見つかりません($bin_dir がありません)" >&2
  exit 1
fi

header() { # $1 のファイルの、2行目から始まるコメントブロックを「# 」を外して出す
  awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$1"
}

# シェル関数の定義(`name() {`)の直上に続くコメントブロックを、ファイルごとに 名前<TAB>ブロック で出す。
# ブロックの行は \n でつなぐ(一覧では1行目だけ、`dotfiles-help <名前>` では全部を使う)
functions_tsv() {
  awk '
    FNR == 1 { block = "" }
    /^[ \t]*#/ { line = $0; sub(/^[ \t]*# ?/, "", line); block = block (block == "" ? "" : "\\n") line; next }
    /^[ \t]*[a-z][a-z0-9_]*\(\) *\{/ {
      name = $0; sub(/^[ \t]*/, "", name); sub(/\(\).*/, "", name)
      print name "\t" block
    }
    { block = "" }
  ' "$shell_dir"/*.sh
}

case "${1:-}" in
  -h | --help)
    header "$0"
    exit 0
    ;;
  "") ;;
  *)
    if [ -f "$bin_dir/$1" ]; then
      header "$bin_dir/$1"
      exit 0
    fi
    block=$(functions_tsv | awk -F '\t' -v n="$1" '$1 == n { print $2; exit }')
    if [ -n "$block" ]; then
      printf '%s\n' "$block" | awk '{ gsub(/\\n/, "\n"); print }'
      exit 0
    fi
    echo "dotfiles-help: $1 というコマンド・シェル関数はありません(一覧は dotfiles-help)" >&2
    exit 1
    ;;
esac

# 端末に出すときだけ色を付け、説明を幅で切る(パイプや NO_COLOR では素のまま)
cols=0
if [ -t 1 ]; then
  size=$(stty size </dev/tty 2>/dev/null || true)
  cols=${size#* }
  case $cols in '' | *[!0-9]*) cols=${COLUMNS:-80} ;; esac
  case $cols in '' | *[!0-9]*) cols=80 ;; esac
fi
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  esc=$(printf '\033')
  B="${esc}[1m" D="${esc}[2m" C="${esc}[36m" R="${esc}[0m"
else
  B="" D="" C="" R=""
fi

# 用途の分け方(説明そのものは各スクリプトから読む)。0 は一覧に出さない
group_of() {
  case $1 in
    dotfiles-update | dotfiles-switch | agent-plugins-setup | nix-gc-setup) echo 1 ;;
    diskreport | cachesweep | aidata | pkgwhere | git-branch-sweep) echo 2 ;;
    extract | clipcopy | clippaste | explorer | notify) echo 3 ;;
    word | excel | powerpoint | outlook | onenote | teams | arduino | fusion360) echo 4 ;;
    wsl-* | wincred) echo 5 ;;
    # 自分自身と、他コマンドの共通実体で直接使わないもの
    dotfiles-help | office-open) echo 0 ;;
    *) echo 9 ;;
  esac
}
title_of() {
  case $1 in
    1) echo "反映と更新" ;;
    2) echo "調べる・片付ける" ;;
    3) echo "ファイルとクリップボード" ;;
    4) echo "アプリを開く" ;;
    5) echo "WSL" ;;
    9) echo "その他" ;;
  esac
}

# 説明の1文目を取り出す awk の関数。括弧の中の「。」では切らない
# (index と substr だけで数えるので、awk が文字単位でもバイト単位でも同じに動く)
awk_sentence='
function sentence(s,    out, best, tok, p, i, depth) {
  out = ""; depth = 0
  while (1) {
    best = 0
    for (i = 1; i <= ntok; i++) { p = index(s, T[i]); if (p && (!best || p < best)) { best = p; tok = T[i] } }
    if (!best) return out s
    out = out substr(s, 1, best - 1 + length(tok))
    s = substr(s, best + length(tok))
    if (tok == "(") depth++
    else if (tok == ")") { if (depth > 0) depth-- }
    else if (depth == 0) return out
  }
}
BEGIN { ntok = split("(|)|。", T, "|") }
'

# コマンド: 名前<TAB>説明。コメントブロックを1文にまとめてから1文目を取る(文が複数行にまたがっても切れない)
set --
for f in "$bin_dir"/*; do
  [ -f "$f" ] && [ -x "$f" ] && set -- "$@" "$f"
done
commands=$(
  LC_ALL=C awk "$awk_sentence"'
    function emit(  d) { d = sentence(s); sub(/。$/, "", d); print name "\t" d }
    FNR == 1 { if (name != "") emit(); name = FILENAME; sub(/.*\//, "", name); s = ""; done = 0; next }
    done { next }
    !/^#/ { done = 1; next }
    {
      line = $0; sub(/^# */, "", line)
      # 行をつなぐとき、英数字・記号どうしが隣り合うなら空白を1つ挟む(日本語どうしはそのまま)
      if (s != "" && line != "" && (s ~ /[ -~]$/ || line ~ /^[ -~]/)) s = s " "
      s = s line
    }
    END { if (name != "") emit() }
  ' "$@" | while IFS="$(printf '\t')" read -r name desc; do
    printf '%s\t%s\t%s\n' "$(group_of "$name")" "$name" "$desc"
  done
)
functions=$(functions_tsv | LC_ALL=C awk -F '\t' "$awk_sentence"'
  { d = $2; sub(/\\n.*/, "", d); d = sentence(d); sub(/。$/, "", d); print $1 "\t" d }')

# 名前の列の幅(ASCII の名前だけなので文字数 = 桁数)
w=$(printf '%s\n%s\n' "$commands" "$functions" | awk -F '\t' '{ n = (NF == 3 ? $2 : $1); if (length(n) > w) w = length(n) } END { print (w > 24 ? 24 : w) }')

# 名前<TAB>説明 を、名前の幅をそろえて出す。cols が 0 でなければ説明を端末の幅で切る。
# 桁数は UTF-8 を見て数える(3バイト文字は2桁、ただし記号の多い U+2000〜2FFF は1桁)。
# awk がバイト単位で数える実装(mawk・古い BWK awk・C ロケールの gawk)でも文字単位でも動くよう、
# 「あ」の長さで見分ける。名前だけの行(タブ無し)は、薄い色の1行として出す($1: その行の字下げ。既定は空白2つ)
fmt() {
  LC_ALL=C awk -F '\t' -v ind="${1-  }" -v w="$w" -v cols="$cols" -v cn="$C" -v cd="$D" -v cr="$R" '
    BEGIN { bytemode = (length("あ") == 3); narrow = "·—–→←…✓⚠" }
    function fit(s, max,    i, n, c, len, cw, used, cut) {
      if (cols == 0) return s
      if (max < 10) max = 10
      n = length(s); used = 0; cut = 0
      for (i = 1; i <= n; i += len) {
        c = substr(s, i, 1)
        if (bytemode) {
          if (c < "\200") { len = 1; cw = 1 }
          else if (c >= "\360") { len = 4; cw = 2 }
          else if (c >= "\340") { len = 3; cw = (c == "\342") ? 1 : 2 }
          else if (c >= "\300") { len = 2; cw = 1 }
          else { len = 1; cw = 0 }
        } else {
          len = 1; cw = (c ~ /^[ -~]$/ || index(narrow, c)) ? 1 : 2
        }
        if (!cut && used + cw > max - 1) cut = i
        used += cw
        if (used > max) return substr(s, 1, cut - 1) "…"
      }
      return s
    }
    NF == 1 { print ind cd fit($1, cols - length(ind)) cr; next }
    { printf("  %s%-" w "s%s  %s\n", cn, $1, cr, fit($2, cols - 4 - w)) }
  '
}

is_wsl=false
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
  is_wsl=true
fi

printf '%sdotfiles%s  自作コマンドとシェル関数\n' "$B" "$R"
printf '%s\n' "詳しく: dotfiles-help <名前>(コマンドは <名前> --help でも同じ)" | fmt ""

for g in 1 2 3 4 5 9; do
  rows=$(printf '%s\n' "$commands" | awk -F '\t' -v g="$g" '$1 == g { print $2 "\t" $3 }')
  [ -n "$rows" ] || continue
  printf '\n%s%s%s\n' "$B" "$(title_of "$g")" "$R"
  if [ "$g" = 5 ] && [ "$is_wsl" = false ]; then
    names=$(printf '%s\n' "$rows" | cut -f 1 | tr '\n' ' ')
    printf '%s\n' "WSL でだけ使う: ${names% }" | fmt
  else
    printf '%s\n' "$rows" | fmt
  fi
done

printf '\n%sシェル関数%s\n' "$B" "$R"
printf '%s\n' "$functions" | fmt
echo ""
printf '%s\n' "cd 系の関数は、実際に移動したときだけ終了コード 0 を返す(README「ユーティリティ」参照)。" | fmt ""
