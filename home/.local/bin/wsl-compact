#!/bin/sh
# WSL の仮想ディスク(ext4.vhdx)を圧縮し、空き領域を Windows 側に返す。
# WSL 内でファイルを削除しても vhdx は自動では縮まないため、Windows 側での
# diskpart 圧縮が必要になる。このコマンドはその手順を自動化する:
#   1. Windows の一時フォルダに diskpart スクリプトと PowerShell スクリプトを生成
#   2. 管理者権限の PowerShell を起動(UAC の確認ダイアログが出る)
#   3. Windows 側で wsl --shutdown → diskpart compact が実行される
#      (シャットダウンでこの WSL セッションも終了するため、続きは Windows 側の
#       ウィンドウが引き継ぐ。全 WSL セッションが一旦終了する点に注意)
# 使い方:
#   wsl-compact           # 仮想ディスクを圧縮
#   wsl-compact --log     # 過去の圧縮結果(前後のサイズ)を表示する
#   wsl-compact --sparse  # 代わりに Sparse VHD(自動回収)を有効化する(WSL 2.0+)
# 圧縮の前後のサイズは Windows 側の %LOCALAPPDATA%\dotfiles\wsl-compact.log に
# 1 回 1 行で追記される(diskpart 自体は結果を記録しないため。圧縮中は WSL が
# 停止しているので WSL 側には書けない)。
set -eu

if [ -z "${WSL_DISTRO_NAME:-}" ] && ! grep -qi microsoft /proc/version 2>/dev/null; then
  echo "wsl-compact: WSL 専用のコマンドです(この環境では何もしません)" >&2
  exit 0
fi

if ! command -v reg.exe >/dev/null 2>&1 || ! command -v powershell.exe >/dev/null 2>&1; then
  echo "wsl-compact: reg.exe / powershell.exe が見つかりません(Windows 連携が無効?)" >&2
  exit 0
fi

# Windows 側の環境変数を取得する(%TEMP% / %LOCALAPPDATA% の解決に使う)
_win_env() {
  (
    cd /mnt/c 2>/dev/null || cd /
    cmd.exe /c "echo %$1%" 2>/dev/null | tr -d '\r'
  )
}

log_win="$(_win_env LOCALAPPDATA)\\dotfiles\\wsl-compact.log"

if [ "${1:-}" = --log ]; then
  log_unix=$(wslpath -u "$log_win" 2>/dev/null) || log_unix=""
  if [ -n "$log_unix" ] && [ -s "$log_unix" ]; then
    tr -d '\r' <"$log_unix"
  else
    echo "wsl-compact: まだ圧縮の実行履歴がありません"
  fi
  exit 0
fi

if [ "${1:-}" = --sparse ]; then
  echo "Sparse VHD(空き領域の自動回収)を有効化します。全 WSL セッションが一旦終了します。"
  exec wsl.exe --manage "${WSL_DISTRO_NAME:?WSL_DISTRO_NAME が未設定です}" --set-sparse true
fi

# レジストリから現在のディストリの vhdx の場所を特定する
regout=$(reg.exe query 'HKCU\Software\Microsoft\Windows\CurrentVersion\Lxss' /s 2>/dev/null | tr -d '\r')
base=$(printf '%s\n' "$regout" | awk -v d="${WSL_DISTRO_NAME:-}" '
  /^HKEY_/ { name=""; path="" }
  $1 == "DistributionName" { name = $3 }
  $1 == "BasePath" {
    path = $3
    for (i = 4; i <= NF; i++) path = path " " $i
  }
  name == d && path != "" { print path; exit }
')
base=$(printf '%s\n' "$base" | sed 's/^\\\\?\\//')

if [ -z "$base" ]; then
  echo "wsl-compact: このディストリ(${WSL_DISTRO_NAME:-不明})の vhdx を特定できませんでした" >&2
  exit 1
fi

vhdx="$base\\ext4.vhdx"
if [ ! -e "$(wslpath -u "$vhdx" 2>/dev/null)" ]; then
  echo "wsl-compact: 仮想ディスクが見つかりません: $vhdx" >&2
  exit 1
fi

# Windows の一時フォルダに diskpart スクリプトと PowerShell スクリプトを生成
wintemp=$(_win_env TEMP)
# ファイル名は毎回ランダムにする(固定名だと生成〜管理者実行の隙に
# 別プロセスが差し替える攻撃が成立しうるため)
rand=$(od -An -N4 -tx4 /dev/urandom 2>/dev/null | tr -d ' \n') || rand=""
[ -n "$rand" ] || rand=$$
dp_win="$wintemp\\dotfiles-wsl-compact-$rand.diskpart.txt"
ps_win="$wintemp\\dotfiles-wsl-compact-$rand.ps1"

printf 'select vdisk file="%s"\r\nattach vdisk readonly\r\ncompact vdisk\r\ndetach vdisk\r\nexit\r\n' \
  "$vhdx" >"$(wslpath -u "$dp_win")"

# PowerShell に埋め込むパスはシングルクォート文字列にし、' は '' に二重化して
# エスケープする(%TEMP% がクォートや特殊文字を含むパスでも壊れないように)
dp_win_q=$(printf '%s' "$dp_win" | sed "s/'/''/g")
ps_win_q=$(printf '%s' "$ps_win" | sed "s/'/''/g")
vhdx_q=$(printf '%s' "$vhdx" | sed "s/'/''/g")
log_win_q=$(printf '%s' "$log_win" | sed "s/'/''/g")
distro_q=$(printf '%s' "${WSL_DISTRO_NAME:-?}" | sed "s/'/''/g")

# Windows PowerShell 5.1 は BOM なしのファイルをシステムのコードページ(日本語環境
# なら CP932)で読むため、UTF-8 の日本語が化けて「文字列に終端記号 " がありません」
# という構文エラーになり、管理者ウィンドウが何もせず即閉じる。UTF-8 と判定させる
# ために先頭に BOM(EF BB BF)を付ける。
ps_unix=$(wslpath -u "$ps_win")
printf '\357\273\277' >"$ps_unix"
# 前半(sh 側の値の受け渡し)だけ変数展開し、PowerShell 本体は展開なし(<<'EOF')で
# 書く。本体側の $ を sh にさらわれないようにするため。
cat >>"$ps_unix" <<EOF
\$vhdx = '$vhdx_q'
\$log = '$log_win_q'
\$distro = '$distro_q'
\$diskpartScript = '$dp_win_q'
EOF
cat >>"$ps_unix" <<'EOF'
$before = (Get-Item -LiteralPath $vhdx).Length
Write-Host ("現在のサイズ: {0:0.0} GB" -f ($before / 1GB))
Write-Host "WSL を終了します..."
wsl --shutdown
Start-Sleep -Seconds 3
Write-Host "仮想ディスクを圧縮しています(数分かかることがあります)..."
diskpart /s $diskpartScript
$rc = $LASTEXITCODE
$after = (Get-Item -LiteralPath $vhdx).Length
$result = "{0:0.0} GB -> {1:0.0} GB ({2:+0.0;-0.0;0.0} GB)" -f ($before / 1GB), ($after / 1GB), (($after - $before) / 1GB)
if ($rc -ne 0) { $result += "  [失敗: diskpart exit $rc]" }
Write-Host ""
Write-Host $result
# diskpart は結果を記録しないので、前後のサイズを 1 行ずつ追記して履歴にする
# (wsl-compact --log で表示)。BOM なし UTF-8 で書く(WSL 側で cat しやすいように)
try {
  $null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $log)
  $line = "{0}  {1}  {2}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm'), $distro, $result
  [System.IO.File]::AppendAllText($log, $line + "`r`n", (New-Object System.Text.UTF8Encoding $false))
} catch {
  Write-Host "履歴の記録に失敗しました: $_"
}
Write-Host ""
Write-Host "完了しました。Enter キーで閉じます"
Read-Host
EOF

size_now=$(stat -c %s "$(wslpath -u "$vhdx")" 2>/dev/null | awk '{ printf "%.1f GB", $1 / 1073741824 }')
printf '対象: %s(現在 %s)\n' "$vhdx" "${size_now:-不明}"
echo "管理者権限の PowerShell を起動します(UAC の確認が出ます)。"
echo "この WSL セッションはまもなく終了し、続きは Windows 側のウィンドウで実行されます。"
(
  cd /mnt/c 2>/dev/null || cd /
  powershell.exe -NoProfile -Command \
    "Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','$ps_win_q'"
)
