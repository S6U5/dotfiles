#!/bin/sh
# マージ済み・リモートで削除済みのローカルブランチを一覧にする(--delete で確認しながら削除)。
# 使い方: git-branch-sweep [--delete] [--no-fetch]   (git branch-sweep でも呼べる)
# 候補にする理由は2つ:
#   merged … 既定ブランチ(origin/main 等)に普通にマージされている
#   gone   … 追跡していたリモートブランチが消えている(GitHub で PR をマージしてブランチを削除した等。
#            スカッシュマージ・リベースマージは merged では拾えないので、こちらで拾う)
# 現在のブランチ・既定ブランチ・他の worktree で使用中のブランチは対象外。
# 削除は git branch -d(マージ済みのみ消せる)。gone だけのブランチで -d が断られたら、
# マージされていない変更があるかもしれないので、1本ずつ聞いてから -D で消す(既定は消さない)。
set -eu

delete=0
fetch=1
for arg in "$@"; do
  case "$arg" in
    --delete) delete=1 ;;
    --no-fetch) fetch=0 ;;
    -h | --help)
      sed -n '2,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "git-branch-sweep: 不明な引数です: $arg" >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "git-branch-sweep: git リポジトリの中ではありません" >&2
  exit 1
fi

# リモートで消えたブランチを gone として見えるようにする(失敗しても手元の情報で続ける)
if [ "$fetch" -eq 1 ] && git remote | grep -qx origin; then
  git fetch --prune --quiet origin 2>/dev/null ||
    echo "git-branch-sweep: git fetch に失敗しました。手元の情報だけで判定します" >&2
fi

# 既定ブランチ: origin/HEAD が指す先 → 無ければ main / master のうちあるもの
default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||') || default=
if [ -z "$default" ]; then
  for b in main master; do
    if git show-ref --verify --quiet "refs/heads/$b" || git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      default=$b
      break
    fi
  done
fi
if [ -z "$default" ]; then
  echo "git-branch-sweep: 既定ブランチが分かりません(origin/HEAD も main / master も無い)" >&2
  exit 1
fi
# 比較の基準はリモート側を優先する(手元の main が古くてもマージ済みを正しく拾うため)
if git show-ref --verify --quiet "refs/remotes/origin/$default"; then
  base=origin/$default
else
  base=$default
fi

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || current=
here=$(git rev-parse --show-toplevel)
merged=$(git branch --merged "$base" --format='%(refname:short)')

# 1行1件: 名前<TAB>理由<TAB>最終コミット
list=$(
  # 区切りは \001(ブランチ名に使えない制御文字)。タブだと IFS の空白扱いで空の欄が詰められてしまう
  git for-each-ref --format='%(refname:short)%01%(upstream:track)%01%(worktreepath)%01%(committerdate:relative)' refs/heads |
    while IFS="$(printf '\001')" read -r name track wt date; do
      [ "$name" = "$default" ] && continue
      [ "$name" = "$current" ] && continue
      # 他の worktree で使用中のものは消せないので除く
      if [ -n "$wt" ] && [ "$wt" != "$here" ]; then
        continue
      fi
      reason=
      if printf '%s\n' "$merged" | grep -qxF -- "$name"; then
        reason=merged
      fi
      if [ "$track" = "[gone]" ]; then
        reason=${reason:+$reason,}gone
      fi
      [ -n "$reason" ] && printf '%s\t%s\t%s\n' "$name" "$reason" "$date"
    done
) || true

if [ -z "$list" ]; then
  echo "片付けられるブランチはありません(基準: $base)"
  exit 0
fi

echo "片付けられるブランチ(基準: $base):"
printf '%s\n' "$list" | awk -F '\t' '{ printf "  %-40s %-12s %s\n", $1, $2, $3 }'

if [ "$delete" -eq 0 ]; then
  echo
  echo "削除するには: git-branch-sweep --delete"
  exit 0
fi

if [ ! -t 0 ] && [ ! -r /dev/tty ]; then
  echo "git-branch-sweep: 確認ができない環境なので削除しません" >&2
  exit 1
fi
ask() {
  printf '%s [y/N] ' "$1"
  read -r answer </dev/tty || answer=
  case "$answer" in
    y | Y | yes) return 0 ;;
    *) return 1 ;;
  esac
}

echo
ask "上の $(printf '%s\n' "$list" | wc -l | tr -d ' ') 本を削除しますか?" || {
  echo "削除しませんでした"
  exit 0
}

rc=0
# 1本ずつ確認するため、ループの標準入力はファイルにする(確認は /dev/tty から読む)
work=$(mktemp "${TMPDIR:-/tmp}/git-branch-sweep.XXXXXX")
trap 'rm -f "$work"' EXIT
printf '%s\n' "$list" | cut -f1,2 >"$work"
while IFS="$(printf '\t')" read -r name reason; do
  if git branch -d --quiet -- "$name" 2>/dev/null; then
    echo "削除: $name"
    continue
  fi
  case "$reason" in
    *merged*)
      echo "削除できませんでした: $name" >&2
      rc=1
      ;;
    *)
      # gone だけ: スカッシュマージ済みなら中身は既定ブランチにあるが、未マージの変更の可能性もある
      echo "$name は $base にマージされた形跡がありません(スカッシュマージなら問題なし)"
      if ask "  強制削除(git branch -D)しますか?"; then
        git branch -D --quiet -- "$name" && echo "削除: $name" || rc=1
      else
        echo "  残しました: $name"
      fi
      ;;
  esac
done <"$work"
exit "$rc"
